# The web console is observation-only unless this is explicitly changed to 1.
SOARM_ENABLE_MOTION=0
SOARM_CAMERA_ROLES_CONFIRMED=0
SOARM_MAX_RELATIVE_TARGET=2
SOARM_WEB_HOST=127.0.0.1
SOARM_WEB_PORT=8088

SOARM_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90149286-if00
SOARM_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90147327-if00
SOARM_SCENE_CAMERA=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:11.4:1.0-video-index0
SOARM_WRIST_CAMERA=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:5:1.0-video-index0
SOARM_LEADER_ID=soarm101_leader
SOARM_FOLLOWER_ID=soarm101_follower

# Recording (used only after calibration and explicit motion enable)
SOARM_TASK=Pick up the object and place it in the tray
SOARM_NUM_EPISODES=10
SOARM_EPISODE_SECONDS=30
SOARM_RESET_SECONDS=15
# Optional; defaults to a unique UTC timestamp.
# SOARM_DATASET_NAME=soarm101_pick_place_001

# --- 가상 리더 (물리 리더 팔 없이 3D 뷰어로 조작) ---
# 조작 권한 토큰. 관찰(상태·카메라·텔레메트리 구독)에는 필요 없고, follower를 움직이는
# 요청에만 필요하다. 비어 있으면 서버는 어떤 조작 권한도 발급하지 않는다.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SOARM_MOTION_TOKEN=

# 안전 사다리의 문턱값. 전부 기본값이 들어 있으므로 비워 두어도 된다. 근거와 아직
# 실측하지 못한 것은 맥 앱 저장소의 docs/원격_텔레옵_안전.md에 적혀 있다.
# SOARM_VL_HZ=30
# SOARM_VL_STEP_DEG=2
# SOARM_VL_STEP_PERCENT=3
# SOARM_VL_COMMAND_TIMEOUT_MS=300
# SOARM_VL_LEASE_TTL_MS=5000
# SOARM_VL_SYNC_TOLERANCE_DEG=6
# SOARM_VL_LOAD_TRIP=400
# SOARM_VL_CURRENT_TRIP=108
# SOARM_VL_FOLLOW_ERROR_DEG=12
# SOARM_VL_TEMP_WARN_C=58
# SOARM_VL_TEMP_TRIP_C=65
# SOARM_VL_RETREAT_DEG=4
# 시험용. `simulated`이면 serial을 열지 않고 흉내 낸 팔로워로 돈다.
# SOARM_VL_BACKEND=real

# 학습 서버(DGX Spark)로 데이터셋을 보내고 체크포인트를 되받는다. 비워 두면 그 기능만 꺼진다.
# tailnet(MagicDNS) 이름을 권한다 — 집 안에서도 밖에서도 같은 이름이 같은 기계를 가리킨다.
# 콘솔 서버의 SSH 공개키가 학습 서버의 authorized_keys에 있어야 한다.
SOARM_SPARK_HOST=
SOARM_SPARK_USER=
SOARM_SPARK_DATASET_ROOT=data/soarm
SOARM_SPARK_OUTPUT_ROOT=outputs
