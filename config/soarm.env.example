# The web console is observation-only unless this is explicitly changed to 1.
SOARM_ENABLE_MOTION=0
SOARM_CAMERA_ROLES_CONFIRMED=0
SOARM_MAX_RELATIVE_TARGET=2
SOARM_WEB_HOST=127.0.0.1
SOARM_WEB_PORT=8088

SOARM_LEADER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90149286-if00
SOARM_FOLLOWER_PORT=/dev/serial/by-id/usb-1a86_USB_Single_Serial_5B90147327-if00
SOARM_SCENE_CAMERA=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:7:1.0-video-index0
SOARM_WRIST_CAMERA=/dev/v4l/by-path/pci-0000:00:14.0-usb-0:8:1.0-video-index0
SOARM_LEADER_ID=soarm101_leader
SOARM_FOLLOWER_ID=soarm101_follower

# Recording (used only after calibration and explicit motion enable)
SOARM_TASK=Pick up the object and place it in the tray
SOARM_NUM_EPISODES=10
SOARM_EPISODE_SECONDS=30
SOARM_RESET_SECONDS=15
# Optional; defaults to a unique UTC timestamp.
# SOARM_DATASET_NAME=soarm101_pick_place_001
